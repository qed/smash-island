{
  "name": "battle-for-smash-island",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev": "electron .",
    "build": "vite build",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.js\" \"electron/**/*.cjs\""
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource/fredoka": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.10.0",
    "jsdom": "^25.0.0",
    "pngjs": "^7.0.0",
    "terser": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.smashisland.game",
    "files": [
      "artifacts/V1/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "productName": "Battle for Smash Island",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
